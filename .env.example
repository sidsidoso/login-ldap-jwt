# Porta HTTP da API
PORTA=3000

# LDAP (valores abaixo apontam para o servidor fake: npm run ldap:fake)
LDAP_URL=ldap://127.0.0.1:1389
LDAP_BASE_USUARIOS=ou=usuarios,dc=empresa,dc=local
LDAP_BIND_DN=cn=svc-login,ou=servicos,dc=empresa,dc=local
LDAP_BIND_SENHA=svc-demo-123
# Atributo de login: uid (OpenLDAP) ou sAMAccountName (Active Directory)
LDAP_ATRIBUTO_LOGIN=uid
LDAP_TIMEOUT_MS=5000

# JWT (gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SEGREDO=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRA_EM=15m
JWT_EMISSOR=login-ldap-jwt
JWT_AUDIENCIA=apis-internas

# Mapa "CN do grupo" -> "papel" (JSON)
MAPA_PAPEIS={"ti-admins":"admin","financeiro":"financeiro","colaboradores":"usuario"}

# Limite de tentativas de login por IP
LOGIN_MAX_TENTATIVAS=10
LOGIN_JANELA_MS=900000

# Porta do servidor LDAP fake
LDAP_FAKE_PORTA=1389
